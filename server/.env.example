# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (service role key — never expose this to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
PORT=3001
FRONTEND_URL=http://localhost:5173

# PDF export (DOCX → PDF) uses a headless LibreOffice. Install it and either put
# `soffice` on PATH or point SOFFICE_PATH at the binary. macOS:
#   brew install --cask libreoffice
#   SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# If unset/missing, PDF export is skipped (non-fatal) and only the .docx is offered.
SOFFICE_PATH=soffice

# Email (Resend)
RESEND_API_KEY=re_...

# Internal webhooks. WEBHOOK_SECRET also guards POST /api/maintenance/cleanup-expired
# (the daily file-deletion sweep, scheduled by Supabase pg_cron — see server/sql/cleanup_cron.sql).
WEBHOOK_URL=http://localhost:5678/webhook-test/...
WEBHOOK_SECRET=some-random-secret-string

# AI passes (Step C/D formatting, Step P proofreading) — via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-oss-120b:free
# Per-step model overrides (optional) — each falls back to AI_MODEL when unset.
# Lets a single document use a strong model where it matters (heading classification)
# and a cheaper/faster one where it doesn't (proofreading).
#   AI_HEADING_MODEL    — Step D, heading reclassification
#   AI_REFERENCES_MODEL — Step C, reference reformatting
#   AI_PROOFREAD_MODEL  — Step P, proofreading
AI_HEADING_MODEL=
AI_REFERENCES_MODEL=
AI_PROOFREAD_MODEL=
AI_FORMATTING_ENABLED=false
AI_PROOFREADING_ENABLED=false   # Step P (proofreading), toggled independently of C/D
# Determinism knobs — keep run-to-run heading results consistent
AI_TEMPERATURE=0          # 0 = greedy/deterministic decode
AI_SEED=7                 # fixed RNG seed where the provider honours it
# Pin routing to one backend so OpenRouter doesn't swap hardware between runs.
# Comma-separated provider slug(s), in preference order; leave empty to route freely.
# Find valid slugs on the model's OpenRouter page (Providers tab), e.g. "deepinfra,fireworks".
AI_PROVIDER=
# Tuning (optional)
# Combined reasoning+output budget for Step C/D. With a reasoning model most of it is spent
# thinking, so it MUST exceed (expected reasoning + the JSON) or the answer truncates and the
# parse fails (finishReason: length). 16k clears a heavy front-matter chunk. Pair with a capped
# reasoning effort below. (Too small here — e.g. 2048 — guarantees failure on reasoning models.)
AI_MAX_TOKENS=16384
# Step P (proofreading) output budget. Also reasoning+output combined, so it can't be tiny for a
# reasoning model either — keep it large enough to clear the chain-of-thought plus the JSON.
AI_PROOFREAD_MAX_TOKENS=8192
# Reasoning effort per structured-JSON pass (OpenRouter `reasoning.effort`). An uncapped reasoning
# model deliberates every ambiguous paragraph and can spend the whole output budget on
# chain-of-thought without ever emitting the JSON (the `finishReason: length` failure). Capping it
# keeps the model answering. One of none|minimal|low|medium|high|xhigh. Default: low.
# If a pass still truncates on a hard doc, drop it to minimal (or none).
AI_PROOFREAD_REASONING_EFFORT=low
AI_HEADING_REASONING_EFFORT=low
AI_REFERENCES_REASONING_EFFORT=low
AI_MAX_CHARS_PER_CHUNK=8000
# Max paragraphs per Step D/P chunk, independent of the char budget above. Front matter / TOC are
# many SHORT lines that all fit the char budget, so a char-only split packs dozens into one call and
# a reasoning model over-deliberates the whole batch (the finishReason: length failure). This caps
# the count so each call stays small — the Step C referencesMaxEntries lesson applied to D and P.
AI_MAX_BLOCKS_PER_CHUNK=12
# Max reference entries per Step C call. References are short, so the char budget
# alone batches all of them into one request — but a reasoning model handed many
# entries at once over-reasons and drops most (observed: 10 sent, 1 returned).
# Small batches keep each call tractable and the output count stable.
AI_REFERENCES_MAX_ENTRIES=3
AI_CONCURRENCY=2
AI_MAX_RETRIES=2
